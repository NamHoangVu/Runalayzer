# Supabase project settings (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared dashboard password (this app has no per-user login yet, just one gate).
APP_PASSWORD=

# Random secret used to sign the session cookie, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Garmin credentials are NOT read by this app — they only ever live as
# GitHub Actions repo secrets for the ingestion job in /ingest. See
# ingest/README.md.
